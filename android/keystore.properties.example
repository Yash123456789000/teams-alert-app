# Copy this file to android/keystore.properties (which is git-ignored) and fill in
# the real values. Never commit keystore.properties or the keystore itself.
#
# storeFile is resolved RELATIVE TO android/app/ (so the value below means
# android/app/teamsalert-release.keystore). An absolute path also works.
storeFile=teamsalert-release.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=teamsalert
keyPassword=CHANGE_ME_KEY_PASSWORD
